{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "server:serve",
      "type": "npm",
      "script": "serve",
      "path": "packages/server",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "client:serve",
      "type": "npm",
      "script": "serve",
      "path": "packages/client",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "serve",
      "dependsOn": ["server:serve", "client:serve"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
